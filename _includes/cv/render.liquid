{%- comment -%}
  Local override of al_folio_cv's render.liquid: a one-page CV overview.
  Reads RenderCV data (site.data.cv, or site.data[page.cv_data]); the full CV is the PDF.
  Each entry is one row: years, then title and a muted line.
{%- endcomment -%}
{%- assign lang = page.lang | default: "en" -%}
{%- assign tr = site.data.i18n[lang] -%}
{%- assign t = tr.cv -%}
{%- assign cv_source = site.data[page.cv_data] | default: site.data.cv -%}
{%- assign cv = cv_source.cv -%}
{%- assign pubs_url = "/publications/" -%}
{%- assign order = "Experience,Education,Awards,Projects,Publications" | split: "," -%}
<div class="post cv-page">
  <header class="cv-head">
    <h1 class="post-title">{{ page.title }}</h1>
    {%- if cv.label %}<p class="cv-label">{{ cv.label }}{% if cv.location %}, {{ cv.location }}{% endif %}</p>{% endif %}
    {%- if cv.summary %}<p class="cv-summary">{{ cv.summary }}</p>{% endif %}
    <div class="cv-actions">
      {%- if page.cv_pdf %}
        <a class="outline-button" href="{{ page.cv_pdf | relative_url }}"><i class="fa-solid fa-file-pdf" aria-hidden="true"></i> {{ t.pdf }}</a>
      {%- endif %}
      {%- if cv.email %}<span class="cv-email"><i class="fa-solid fa-envelope" aria-hidden="true"></i> {% al_email_protect_link cv.email %}</span>{% endif %}
    </div>
  </header>

  {%- for name in order %}
    {%- if name == "Publications" %}
      <section class="cv-section" aria-labelledby="cv-publications">
        <h2 class="section-label" id="cv-publications">{{ t.sections.Publications | default: "Publications" }}</h2>
        <p class="cv-note">{{ t.publications_note }} <a href="{{ pubs_url | relative_url }}">{{ tr.all_publications }}</a></p>
      </section>
      {%- continue %}
    {%- endif %}
    {%- assign entries = cv.sections[name] -%}
    {%- if entries == nil or entries.size == 0 %}{% continue %}{% endif %}
    <section class="cv-section" aria-labelledby="cv-{{ name | slugify }}">
      <h2 class="section-label" id="cv-{{ name | slugify }}">{{ t.sections[name] | default: name }}</h2>
      <ol class="cv-rows">
        {%- for e in entries %}
          {%- assign start = e.start_date | append: "" | slice: 0, 4 -%}
          {%- assign end = e.end_date | append: "" | slice: 0, 4 -%}
          {%- if e.end_date == "present" %}{% assign end = t.present %}{% endif -%}
          {%- assign single = e.date | append: "" | slice: 0, 4 -%}
          {%- capture when -%}{%- if start != "" -%}{{ start }}&#8202;–&#8202;{{ end }}{%- else -%}{{ single }}{%- endif -%}{%- endcapture -%}
          {%- case name -%}
            {%- when "Experience" -%}
              {%- assign title = e.position -%}{%- assign org = e.company -%}{%- assign sub = e.location -%}{%- assign url = e.url -%}{%- assign title_url = nil -%}
            {%- when "Education" -%}
              {%- capture title %}{{ e.studyType }}{% if e.area %}, {{ e.area }}{% endif %}{% endcapture -%}
              {%- assign org = e.institution -%}{%- assign sub = e.location -%}{%- assign url = e.url -%}{%- assign title_url = nil -%}
            {%- when "Awards" -%}
              {%- assign title = e.title -%}{%- assign org = e.awarder -%}{%- assign sub = nil -%}{%- assign url = nil -%}{%- assign title_url = e.url | remove: site.url -%}
            {%- when "Projects" -%}
              {%- assign title = e.name -%}{%- assign org = e.summary -%}{%- assign sub = nil -%}{%- assign url = nil -%}{%- assign title_url = e.url -%}
            {%- else -%}
              {%- assign title = e.summary | default: e.keywords -%}{%- assign org = nil -%}{%- assign sub = nil -%}{%- assign url = nil -%}{%- assign title_url = nil -%}{%- assign when = "" -%}
          {%- endcase %}
          <li class="cv-row{% if when == '' %} cv-row-plain{% endif %}">
            {%- if when != "" %}<span class="cv-when">{{ when }}</span>{% endif %}
            <div class="cv-what">
              <span class="cv-title">{% if title_url %}<a href="{{ title_url }}">{{ title }}</a>{% else %}{{ title }}{% endif %}</span>
              {%- if org or sub %}
                <span class="cv-sub">{% if url %}<a href="{{ url }}">{{ org }}</a>{% else %}{{ org }}{% endif %}{% if org and sub %}, {% endif %}{{ sub }}</span>
              {%- endif %}
            </div>
          </li>
        {%- endfor %}
      </ol>
    </section>
  {%- endfor %}

  {%- assign misc = "Languages,Interests" | split: "," %}
  <section class="cv-section cv-misc">
    <ol class="cv-rows">
      {%- for name in misc %}
        {%- for e in cv.sections[name] %}
          <li class="cv-row"><span class="cv-when">{{ t.sections[name] | default: name }}</span><span class="cv-title">{{ e.summary | default: e.keywords }}</span></li>
        {%- endfor %}
      {%- endfor %}
    </ol>
  </section>
</div>
