---
layout: default
---
{% assign lang = page.lang | default: 'en' %}
{% assign t = site.data.i18n[lang] %}
{% if lang == 'de' %}
  {% assign news_url = '/de/neuigkeiten/' %}
  {% assign projects_url = '/de/projekte/' %}
{% else %}
  {% assign news_url = '/news/' %}
  {% assign projects_url = '/repositories/' %}
{% endif %}
<div class="post home">
  <header class="masthead">
    <div class="masthead-text">
      <h1 class="masthead-name">{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="masthead-role">{{ page.subtitle }}</p>
      {% if page.social %}
        <div class="masthead-social contact-icons">{% social_links %}</div>
        <p class="masthead-note">{{ t.contact_note | default: site.contact_note }}</p>
      {% endif %}
    </div>
    {% if page.profile and page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      <div class="masthead-portrait">
        {%
          include figure.liquid loading="eager" path=profile_image_path class="masthead-photo" sizes="(min-width: 576px) 200px, 120px" alt=site.first_name
          cache_bust=true
        %}
      </div>
    {% endif %}
    <div class="home-bio">{{ content }}</div>
  </header>

  {% if page.featured_projects %}
    <section class="home-section" aria-labelledby="home-work">
      <div class="section-head">
        <h2 class="section-label" id="home-work">{{ t.selected_work }}</h2>
        <a class="section-more" href="{{ projects_url | relative_url }}">{{ t.all_projects }}</a>
      </div>
      {% include featured_projects.liquid home=true %}
    </section>
  {% endif %}

  {% if page.announcements and page.announcements.enabled %}
    <section class="home-section" aria-labelledby="home-news">
      <div class="section-head">
        <h2 class="section-label" id="home-news">{{ t.news }}</h2>
        <a class="section-more" href="{{ news_url | relative_url }}">{{ t.all_news }}</a>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-section" aria-labelledby="home-pubs">
      <div class="section-head">
        <h2 class="section-label" id="home-pubs">{{ t.selected_publications }}</h2>
        <a class="section-more" href="{{ '/publications/' | relative_url }}">{{ t.all_publications }}</a>
      </div>
      <div class="pub-compact-list">
        {% bibliography -f papers -q @*[selected=true]* --max 3 --group_by none --template bib_compact %}
      </div>
    </section>
  {% endif %}
</div>
