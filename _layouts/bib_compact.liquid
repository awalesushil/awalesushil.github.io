---
---
{%- assign paper_url = '/publications/' | append: entry.key | append: '/' | relative_url -%}
<div class="pub-compact">
  <a class="pub-thumb" href="{{ paper_url }}" tabindex="-1" aria-hidden="true">
    {%- if entry.preview -%}
      <img src="{{ entry.preview | prepend: '/assets/img/publication_preview/' | relative_url }}" alt="" loading="lazy">
    {%- else -%}
      <span class="pub-thumb-venue">{{ entry.abbr }}</span>
    {%- endif -%}
  </a>
  <div class="pub-text">
    <a class="pub-title" href="{{ paper_url }}">{{ entry.title | unbrace }}</a>
    <p class="pub-meta">
      {{- entry.abbr }} {{ entry.year -}}
      {%- if entry.award_name %} <span class="award-mark"><i class="fa-solid fa-trophy" aria-hidden="true"></i> {{ entry.award_name }}</span>{% endif -%}
    </p>
  </div>
</div>
